{
  "expo": {
    "name": "BIO HUB",
    "slug": "xingsan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "需要蓝牙权限来连接 BIO_HUB 传感器",
        "NSBluetoothPeripheralUsageDescription": "需要蓝牙权限来连接 BIO_HUB 传感器"
      }
    },
    "android": {
      "package": "com.biohub.sensorapp",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "需要蓝牙权限来连接 BIO_HUB 传感器"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "69b829e4-eaea-496f-ba2f-dece3a4ba0fd"
      }
    },
    "owner": "soleil2349s-team"
  }
}
